{
  "name": "loma",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@10.34.6",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "dev": "pnpm --filter @loma/web dev",
    "build": "pnpm --filter @loma/web build",
    "typecheck": "pnpm -r typecheck",
    "lint": "eslint . --max-warnings 0",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "services:start": "node scripts/services-start.mjs",
    "services:stop": "docker compose --env-file .local/runtime.env -f supabase/compose.local.yml stop",
    "local:env": "node scripts/local-env.mjs",
    "local:seed": "node scripts/local-seed.mjs",
    "db:types": "node scripts/database-types.mjs",
    "test:rls": "node scripts/test-rls.mjs",
    "backup:local": "node scripts/backup-local.mjs",
    "test:engine": "vitest run packages/loan-engine --coverage",
    "test:clients": "node scripts/test-clients.mjs",
    "test:applications": "node scripts/test-applications.mjs",
    "test:payments": "node scripts/test-payments.mjs",
    "backfill:local": "node scripts/backfill-loans.mjs",
    "messages:run": "node scripts/message-worker.mjs",
    "messages:watch": "node scripts/message-worker.mjs --watch",
    "test:messages": "node scripts/test-messages.mjs",
    "test:public": "node scripts/test-public.mjs",
    "public:assets": "node scripts/public-assets.mjs",
    "test:site-quality": "node scripts/test-site-quality.mjs"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.10.0",
    "@playwright/test": "1.63.0",
    "@testing-library/jest-dom": "6.9.1",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.0",
    "@types/pg": "^8.23.1",
    "@vitest/coverage-v8": "5.0.3",
    "eslint": "9.39.5",
    "eslint-config-next": "16.4.0",
    "jsdom": "^27.0.0",
    "lighthouse": "^13.5.0",
    "pg": "^8.23.1",
    "prettier": "^3.6.0",
    "supabase": "2.75.0",
    "typescript": "^5.9.0",
    "vitest": "5.0.3"
  },
  "type": "module"
}
