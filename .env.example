# Produção: preencher no ambiente seguro, nunca no Git.
# Desenvolvimento: pnpm local:env cria apps/web/.env.local automaticamente.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# Domínio sem esquema/porta; localhost no ambiente local.
PLATFORM_BASE_DOMAIN=localhost

# Chave técnica de atestação; partilhada com financial_private.signing_key (ver docs/RECOVERY.md).
FINANCIAL_SIGNING_KEY=

# Apenas no processo técnico de mensagens, nunca NEXT_PUBLIC nem no browser.
# Local: services:start configura o contentor automaticamente; produção: ver RECOVERY.md.
COMMUNICATION_DATABASE_URL=
